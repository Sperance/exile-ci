# Задачи Gradle и пути результатов сборок клиента по каналам (flavors direct / play / rustore): единственное место в exile-ci,
# workflow и скрипты читают файл через `. ci/build-tasks.env`. Только KEY=значение без пробелов и кавычек. Если клиент переименует
# задачу или каталог результата - правится только этот файл.
# Один applicationId и один ключ подписи на все каналы.
APP_ID=com.sperance.exileforge

# Прямой APK (свой обновлятор, update.json) и карта R8 к нему
DIRECT_APK_TASK=:app:assembleDirectRelease
DIRECT_APK=app/build/outputs/apk/direct/release/app-direct-release.apk
DIRECT_MAPPING=app/build/outputs/mapping/directRelease/mapping.txt

# Google Play: пакет AAB и карта R8 к нему (Play берёт карту и из самого пакета)
PLAY_AAB_TASK=:app:bundlePlayRelease
PLAY_AAB=app/build/outputs/bundle/playRelease/app-play-release.aab
PLAY_MAPPING=app/build/outputs/mapping/playRelease/mapping.txt

# RuStore: APK и карта R8 к нему
RUSTORE_APK_TASK=:app:assembleRustoreRelease
RUSTORE_APK=app/build/outputs/apk/rustore/release/app-rustore-release.apk
RUSTORE_MAPPING=app/build/outputs/mapping/rustoreRelease/mapping.txt

# Сборка для UI-тестов на эмуляторе (без R8, флаг -PuiTests выбирает тип uiTest инструментального APK) - по прямому каналу
UI_FLAGS=-PuiTests
UI_APP_TASK=:app:assembleDirectUiTest
UI_TEST_TASK=:app:assembleDirectUiTestAndroidTest
UI_APK=app/build/outputs/apk/direct/uiTest/app-direct-uiTest.apk
UI_TEST_APK=app/build/outputs/apk/androidTest/direct/uiTest/app-direct-uiTest-androidTest.apk

# Единственная сжатая R8 сборка с инструментальным APK (строгий смоук ReleaseSmokeTest, без флага) - по прямому каналу
MINIFIED_FLAGS=
MINIFIED_APP_TASK=:app:assembleDirectMinifiedTest
MINIFIED_TEST_TASK=:app:assembleDirectMinifiedTestAndroidTest
MINIFIED_APK_DIR=app/build/outputs/apk/direct/minifiedTest
MINIFIED_TEST_APK_DIR=app/build/outputs/apk/androidTest/direct/minifiedTest
MINIFIED_APK=app/build/outputs/apk/direct/minifiedTest/app-direct-minifiedTest.apk
MINIFIED_TEST_APK=app/build/outputs/apk/androidTest/direct/minifiedTest/app-direct-minifiedTest-androidTest.apk
